# ============================================
# COPIA ESTE ARCHIVO A ".env" Y COMPLETA TUS DATOS REALES
# NUNCA subas el archivo ".env" real a GitHub ni lo compartas
# ============================================

# Entorno: development | production
NODE_ENV=development

# Puerto donde corre el servidor
PORT=4000

# Dominio(s) permitido(s) para hacer peticiones al API (separados por coma)
# En producción pon tu dominio real, ej: https://www.mitienda.com.ec
CORS_ORIGIN=http://localhost:4000,http://localhost:5500

# Secreto para firmar los JWT de sesión del admin.
# Genera uno fuerte con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO_Y_ALEATORIO

# Duración del token de sesión del admin
JWT_EXPIRES_IN=8h

# --- Credenciales iniciales del primer usuario administrador (solo se usan en el seed) ---
ADMIN_EMAIL=admin@mitienda.com.ec
ADMIN_PASSWORD=CambiaEstaClave123!

# --- PayPhone (Cajita de Pagos) ---
# Se obtienen en https://payphone.app/business -> Payphone Developer
# IMPORTANTE: el TOKEN es secreto, nunca lo pongas directo en el HTML del frontend en producción real;
# aquí se sirve al frontend vía un endpoint propio para poder rotarlo sin tocar código.
PAYPHONE_TOKEN=TU_TOKEN_DE_PAYPHONE
PAYPHONE_STORE_ID=TU_STORE_ID_DE_PAYPHONE

# URL pública de tu sitio, usada para armar la URL de respuesta de PayPhone
PUBLIC_APP_URL=http://localhost:5500
